<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Loan Repayment Company</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    min-height:100vh;
    background:
        radial-gradient(circle at top,#263b72 0%,#111827 35%,#050814 100%);
    display:flex;
    align-items:center;
    justify-content:center;
    padding:20px;
    color:#111827;
}

/* MAIN CARD */

.payment-card{
    width:100%;
    max-width:430px;
    background:rgba(255,255,255,.97);
    border-radius:25px;
    padding:25px;
    box-shadow:
        0 25px 70px rgba(0,0,0,.35);
}

/* HEADER */

.header{
    text-align:center;
    margin-bottom:20px;
}

.logo-circle{
    width:62px;
    height:62px;
    margin:auto;
    border-radius:50%;
    background:linear-gradient(135deg,#111827,#374151);
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:27px;
    font-weight:bold;
    box-shadow:0 8px 20px rgba(0,0,0,.2);
}

.company-name{
    margin-top:12px;
    font-size:22px;
    font-weight:800;
}

.subtitle{
    color:#6b7280;
    font-size:13px;
    margin-top:5px;
}

/* TIMER */

.timer-box{
    background:linear-gradient(135deg,#111827,#1f2937);
    color:white;
    border-radius:17px;
    padding:16px;
    text-align:center;
    margin-bottom:20px;
}

.timer-title{
    font-size:12px;
    opacity:.75;
    text-transform:uppercase;
    letter-spacing:1px;
}

#timer{
    font-size:32px;
    font-weight:800;
    margin-top:4px;
}

/* PAYMENT METHODS */

.section-title{
    font-size:13px;
    font-weight:bold;
    color:#6b7280;
    margin-bottom:9px;
}

.methods{
    display:flex;
    gap:9px;
    margin-bottom:20px;
}

.method{
    flex:1;
    padding:13px 4px;
    border-radius:13px;
    border:1px solid #e5e7eb;
    text-align:center;
    background:#fff;
    font-weight:700;
    font-size:13px;
}

.phonepe{
    color:#5f259f;
}

.gpay{
    color:#4285f4;
}

.paytm{
    color:#009cde;
}

/* AMOUNT */

.amount-box{
    background:#f8fafc;
    border:1px solid #e5e7eb;
    border-radius:17px;
    padding:18px;
    text-align:center;
    margin-bottom:15px;
}

.amount-label{
    color:#6b7280;
    font-size:13px;
}

#amount{
    font-size:35px;
    font-weight:900;
    margin-top:5px;
}

/* UPI */

.upi-box{
    background:#f8fafc;
    border:1px solid #e5e7eb;
    border-radius:15px;
    padding:15px;
    margin-bottom:20px;
}

.upi-label{
    font-size:12px;
    color:#6b7280;
    margin-bottom:5px;
}

#upi{
    font-size:16px;
    font-weight:700;
    word-break:break-all;
}

/* UTR */

.input-label{
    display:block;
    font-size:13px;
    font-weight:700;
    margin-bottom:8px;
}

input{
    width:100%;
    padding:15px;
    border:1px solid #d1d5db;
    border-radius:13px;
    outline:none;
    font-size:16px;
    transition:.2s;
}

input:focus{
    border-color:#374151;
    box-shadow:0 0 0 3px rgba(55,65,81,.1);
}

/* BUTTON */

.submit-btn{
    width:100%;
    margin-top:12px;
    padding:16px;
    border:0;
    border-radius:13px;
    background:linear-gradient(135deg,#111827,#374151);
    color:white;
    font-size:16px;
    font-weight:800;
    cursor:pointer;
}

.submit-btn:disabled{
    opacity:.55;
    cursor:not-allowed;
}

/* RESULT */

.result{
    display:none;
    margin-top:18px;
    background:#ecfdf5;
    border:1px solid #a7f3d0;
    border-radius:17px;
    padding:20px;
    text-align:center;
}

.check{
    width:55px;
    height:55px;
    border-radius:50%;
    background:#10b981;
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    margin:0 auto 10px;
    font-size:27px;
    font-weight:bold;
}

.result h3{
    color:#065f46;
    margin-bottom:7px;
}

.result p{
    color:#047857;
    font-size:14px;
    line-height:1.5;
}

/* FOOTER */

.footer{
    text-align:center;
    font-size:11px;
    color:#9ca3af;
    margin-top:18px;
    line-height:1.5;
}

</style>
</head>

<body>

<div class="payment-card">

    <!-- HEADER -->

    <div class="header">

        <div class="logo-circle">
            ₹
        </div>

        <div class="company-name">
            Loan Repayment Company
        </div>

        <div class="subtitle">
            Secure Payment Submission
        </div>

    </div>


    <!-- TIMER -->

    <div class="timer-box">

        <div class="timer-title">
            Payment Session Expires In
        </div>

        <div id="timer">
            10:00
        </div>

    </div>


    <!-- PAYMENT METHODS -->

    <div class="section-title">
        Available Payment Methods
    </div>

    <div class="methods">

        <div class="method phonepe">
            PhonePe
        </div>

        <div class="method gpay">
            G Pay
        </div>

        <div class="method paytm">
            Paytm
        </div>

    </div>


    <!-- AMOUNT -->

    <div class="amount-box">

        <div class="amount-label">
            PAYMENT AMOUNT
        </div>

        <div id="amount">
            ₹6,500
        </div>

    </div>


    <!-- UPI ID -->

    <div class="upi-box">

        <div class="upi-label">
            UPI ID
        </div>

        <div id="upi">
            example@upi
        </div>

    </div>


    <!-- UTR -->

    <label class="input-label">
        Enter UTR / Transaction Number
    </label>

    <input
        type="text"
        id="utr"
        placeholder="Enter your UTR number"
        autocomplete="off"
    >


    <button
        class="submit-btn"
        id="submitBtn"
        onclick="submitUTR()"
    >
        Submit UTR
    </button>


    <!-- RESULT -->

    <div class="result" id="result">

        <div class="check">
            ✓
        </div>

        <h3>
            Payment Submitted
        </h3>

        <p>
            Your UTR has been submitted successfully.
        </p>

        <p style="margin-top:8px;">
            Payment verification is pending.
        </p>

        <p style="margin-top:8px;font-weight:bold;">
            Please wait up to 10 minutes for verification.
        </p>

    </div>


    <div class="footer">
        Payment status will be confirmed only after
        transaction verification.
    </div>

</div>


<script>

/*
=================================================
CUSTOMER PAYMENT INFORMATION
শুধু এই দুইটি পরিবর্তন করলেই হবে
=================================================
*/

const PAYMENT_AMOUNT = "₹6,500";

const UPI_ID = "example@upi";


/*
=================================================
SHOW AMOUNT + UPI
=================================================
*/

document.getElementById("amount").innerText =
    PAYMENT_AMOUNT;

document.getElementById("upi").innerText =
    UPI_ID;


/*
=================================================
10 MINUTE COUNTDOWN
=================================================
*/

let totalSeconds = 10 * 60;

const timerElement =
    document.getElementById("timer");

const countdown = setInterval(function(){

    let minutes =
        Math.floor(totalSeconds / 60);

    let seconds =
        totalSeconds % 60;

    let displaySeconds =
        seconds < 10
        ? "0" + seconds
        : seconds;

    timerElement.innerText =
        minutes + ":" + displaySeconds;


    if(totalSeconds <= 0){

        clearInterval(countdown);

        timerElement.innerText =
            "Expired";

    }

    totalSeconds--;

},1000);


/*
=================================================
UTR SUBMIT
=================================================
*/

function submitUTR(){

    const utr =
        document.getElementById("utr").value.trim();

    if(utr === ""){

        alert("Please enter your UTR number.");

        return;
    }


    /*
    DEMO ONLY:
    UTR submission ≠ payment verification.
    */

    document.getElementById("result")
        .style.display = "block";

    document.getElementById("utr")
        .disabled = true;

    document.getElementById("submitBtn")
        .disabled = true;

    document.getElementById("submitBtn")
        .innerText = "UTR Submitted";

}

</script>

</body>
</html>
